# Parcel Research Tool — environment configuration

# Server
PORT=5000
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=parcel_research
DB_USER=postgres
DB_PASSWORD=postgres

# Set to true to force in-memory auth/data even when PostgreSQL is available
# USE_MEMORY_AUTH=false

# Redis (optional — lookup cache falls back to in-memory if unavailable)
REDIS_HOST=localhost
REDIS_PORT=6379

# Florida live parcel lookup via FDOR ArcGIS (no bulk storage). Set false to disable.
FL_LIVE_LOOKUP=true
LOOKUP_CACHE_TTL_SECONDS=2592000
# FL_ARCGIS_FEATURE_SERVER=https://services9.arcgis.com/.../FeatureServer/0

# Auth
JWT_SECRET=change-this-in-production

# Frontend (create frontend/.env.local if needed)
# REACT_APP_API_URL=http://localhost:5000/api
